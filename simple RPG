                                                                                                                                                                                    <!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <title>Paper Mario 極限閃避測試</title>
    <style>
        body { background-color: #2b2b2b; color: white; font-family: sans-serif; text-align: center; margin-top: 30px; }
        .battle-stage { display: flex; justify-content: center; gap: 20px; margin-bottom: 20px; }
        .character-box { border: 2px solid #ccc; border-radius: 10px; padding: 15px; width: 130px; background-color: #3a3a3a; }
        
        .hp-text { color: #ff6b6b; font-weight: bold; font-size: 18px; }
        .sp-text { color: #54a0ff; font-weight: bold; font-size: 18px; }
        .status-text { color: #feca57; font-weight: bold; font-size: 14px; min-height: 20px; }
        
        .ui-panel { border: 2px solid #aaa; padding: 20px; width: 85%; max-width: 400px; margin: 0 auto; border-radius: 10px; background-color: #1e1e1e; min-height: 150px; }
        #message-box { font-size: 16px; margin-bottom: 20px; color: #feca57; min-height: 40px; white-space: pre-line; }
        
        button { padding: 10px 15px; font-size: 16px; cursor: pointer; border-radius: 5px; border: none; font-weight: bold; margin: 5px; }
        
        #action-menu { display: block; }
        #item-menu { display: none; }
        
        .btn-attack { background-color: #48dbfb; color: #000; }
        .btn-skill { background-color: #9b59b6; color: #fff; }
        .btn-item { background-color: #2ecc71; color: #000; }
        .btn-back { background-color: #7f8c8d; color: #fff; }
        
        #qte-area { display: none; margin-top: 15px; }
        .qte-bar { width: 100%; height: 25px; background-color: #555; border: 2px solid #fff; border-radius: 15px; position: relative; overflow: hidden; margin-bottom: 15px; }
        
        /* 動態判定區塊設定 */
        .qte-target-main { position: absolute; height: 100%; } 
        .qte-target-perfect { position: absolute; height: 100%; z-index: 2; display: none; } /* 閃避區置於上層 */
        
        .qte-cursor { position: absolute; left: 0%; width: 6px; height: 100%; background-color: #fff; box-shadow: 0 0 5px #fff; z-index: 3; }
        
        #action-btn { background-color: #ff9f43; color: #fff; transform: scale(1.1); }
        #action-btn:active { transform: scale(0.9); }
    </style>
</head>
<body>

    <h1>極限閃避系統測試</h1>

    <div class="battle-stage">
        <div class="character-box">
            <h2>布蕾蒂雅</h2>
            <p>HP: <span class="hp-text" id="player-hp">20</span> / 20</p>
            <p>SP: <span class="sp-text" id="player-sp">10</span> / 10</p>
        </div>
        <div class="character-box">
            <h2>赫爾墨斯</h2>
            <div class="status-text" id="enemy-status"></div>
            <p>HP: <span class="hp-text" id="enemy-hp">40</span> / 40</p>
        </div>
    </div>

    <div class="ui-panel">
        <div id="message-box">戰鬥開始！輪到 布蕾蒂雅 行動。</div>
        
        <div id="action-menu">
            <button class="btn-attack" onclick="startAttack()">攻擊</button>
            <button class="btn-skill" onclick="startSkill()">破甲 (4 SP)</button>
            <button class="btn-item" onclick="openItemMenu()">道具</button>
        </div>

        <div id="item-menu">
            <button class="btn-item" onclick="useItem('potion')">回復藥 (<span id="potion-count">3</span>)</button>
            <button class="btn-item" onclick="useItem('ether')">魔法水 (<span id="ether-count">2</span>)</button>
            <button class="btn-back" onclick="closeItemMenu()">返回</button>
        </div>

        <div id="qte-area">
            <div class="qte-bar">
                <div class="qte-target-main" id="qte-main-zone"></div>
                <div class="qte-target-perfect" id="qte-perfect-zone"></div>
                
                <div class="qte-cursor" id="qte-cursor"></div>
            </div>
            <button id="action-btn" onclick="checkQte()">動作！</button>
        </div>
    </div>

    <script>
        let player = { hp: 20, maxHp: 20, sp: 10, maxSp: 10 };
        let enemy = { hp: 40, maxHp: 40, attack: 5, shield: false }; // 稍微提高敵人攻擊力，凸顯閃避重要性
        
        let baseAttack = 3, skillAttack = 6, skillCost = 4, qteBonus = 2;   
        let inventory = { potion: { count: 3, healHp: 10, name: "回復藥" }, ether: { count: 2, healSp: 6, name: "魔法水" } };

        const ui = {
            playerHp: document.getElementById('player-hp'), playerSp: document.getElementById('player-sp'),
            enemyHp: document.getElementById('enemy-hp'), enemyStatus: document.getElementById('enemy-status'),
            msgBox: document.getElementById('message-box'), actionMenu: document.getElementById('action-menu'),
            itemMenu: document.getElementById('item-menu'), qteArea: document.getElementById('qte-area'),
            qteCursor: document.getElementById('qte-cursor'), actionBtn: document.getElementById('action-btn'),
            mainZone: document.getElementById('qte-main-zone'), perfectZone: document.getElementById('qte-perfect-zone')
        };

        let cursorPosition = 0, qteTimer, isQteActive = false, currentAction = "";
        let targetStart = 0, targetEnd = 0, perfectStart = 0, perfectEnd = 0;

        function openItemMenu() { ui.actionMenu.style.display = 'none'; ui.itemMenu.style.display = 'block'; ui.msgBox.innerText = "請選擇道具。"; }
        function closeItemMenu() { ui.itemMenu.style.display = 'none'; ui.actionMenu.style.display = 'block'; ui.msgBox.innerText = "請選擇行動。"; }

        function useItem(itemType) {
            let item = inventory[itemType];
            if (item.count <= 0) return alert(`已經用完了！`);
            item.count--;
            document.getElementById(`${itemType}-count`).innerText = item.count;
            ui.itemMenu.style.display = 'none';

            if (itemType === 'potion') {
                player.hp = Math.min(player.hp + item.healHp, player.maxHp);
                ui.playerHp.innerText = player.hp;
                ui.msgBox.innerText = `回復了 ${item.healHp} 點 HP。`;
            } else {
                player.sp = Math.min(player.sp + item.healSp, player.maxSp);
                ui.playerSp.innerText = player.sp;
                ui.msgBox.innerText = `回復了 ${item.healSp} 點 SP。`;
            }
            setTimeout(enemyTurn, 1500);
        }

        // --- 設定 QTE 區塊的長相與判定範圍 ---
        function configureQteZones(type) {
            if (type === 'attack') {
                // 攻擊：只有一個 20% 寬的綠色目標區 (70% ~ 90%)
                targetStart = 70; targetEnd = 90; perfectStart = -1; perfectEnd = -1; // -1 代表沒有完美區
                ui.mainZone.style.left = '70%'; ui.mainZone.style.width = '20%'; ui.mainZone.style.backgroundColor = '#2ecc71';
                ui.perfectZone.style.display = 'none';
            } else if (type === 'defend') {
                // 防禦與閃避：藍色防禦區 (60% ~ 95%)，中間藏著黃色的閃避區 (75% ~ 81%)
                targetStart = 60; targetEnd = 95; 
                perfectStart = 75; perfectEnd = 81; // 只有 6% 的極限空間！
                
                ui.mainZone.style.left = '60%'; ui.mainZone.style.width = '35%'; ui.mainZone.style.backgroundColor = '#3498db'; // 藍色防禦區
                
                ui.perfectZone.style.display = 'block';
                ui.perfectZone.style.left = '75%'; ui.perfectZone.style.width = '6%'; ui.perfectZone.style.backgroundColor = '#f1c40f'; // 黃色閃避區
            }
        }

        function startAttack() {
            currentAction = "attack"; configureQteZones('attack');
            setupQteUI("打擊！", "#ff9f43", `準備攻擊！\n(進入綠色區域時點擊)`); startQteAnimation(); 
        }

        function startSkill() {
            if (player.sp < skillCost) return alert("SP 不足！"); 
            player.sp -= skillCost; ui.playerSp.innerText = player.sp;
            currentAction = "skill"; configureQteZones('attack');
            setupQteUI("破甲！", "#9b59b6", `施展【破甲擊】！\n(進入綠色區域時點擊)`); startQteAnimation(); 
        }

        function setupQteUI(btnText, btnColor, msg) {
            ui.actionMenu.style.display = 'none'; ui.qteArea.style.display = 'block';  
            ui.actionBtn.innerText = btnText; ui.actionBtn.style.backgroundColor = btnColor; ui.msgBox.innerText = msg;
        }

        function startQteAnimation() {
            cursorPosition = 0; isQteActive = true; ui.qteCursor.style.left = cursorPosition + '%';
            qteTimer = setInterval(() => {
                cursorPosition += 1.5; ui.qteCursor.style.left = cursorPosition + '%';
                if (cursorPosition >= 100) { clearInterval(qteTimer); checkQteResult(); }
            }, 20); 
        }

        function checkQte() {
            if (!isQteActive) return;
            isQteActive = false; clearInterval(qteTimer); checkQteResult();
        }

        // --- 核心判定邏輯 ---
        function checkQteResult() {
            ui.qteArea.style.display = 'none'; 
            
            // 判斷按下的位置
            let isPerfect = (cursorPosition >= perfectStart && cursorPosition <= perfectEnd);
            let isSuccess = (cursorPosition >= targetStart && cursorPosition <= targetEnd);

            if (currentAction === "attack" || currentAction === "skill") {
                if (currentAction === "attack" && enemy.shield) {
                    ui.msgBox.innerText = `攻擊被彈開！赫爾墨斯 有護盾保護。`; setTimeout(enemyTurn, 2000); return;
                }
                
                let dmg = (currentAction === "attack" ? baseAttack : skillAttack) + (isSuccess ? qteBonus : 0);
                let msgPrefix = (currentAction === "skill" && enemy.shield) ? "擊碎護盾！\n" : "";
                if(currentAction === "skill") { enemy.shield = false; ui.enemyStatus.innerText = ""; }
                
                ui.msgBox.innerText = isSuccess ? `${msgPrefix}會心一擊！造成 ${dmg} 點傷害。` : `${msgPrefix}普通攻擊。造成 ${dmg} 點傷害。`;
                dealDamageToEnemy(dmg);
            } 
            else if (currentAction === "defend") {
                if (isPerfect) {
                    // 極限閃避成功！(落在黃色區塊)
                    ui.msgBox.innerText = `💫 極限閃避！\n布蕾蒂雅 靈巧地避開了攻擊，受到 0 點傷害。`;
                    playerHpUpdate(0);
                } else if (isSuccess) {
                    // 普通防禦成功 (落在藍色區塊)
                    let dmgTaken = enemy.attack - qteBonus;
                    ui.msgBox.innerText = `🛡️ 成功防禦！\n減輕了傷害，受到了 ${dmgTaken} 點傷害。`;
                    playerHpUpdate(dmgTaken);
                } else {
                    // 防禦失敗 (按太早、按太晚或沒按)
                    ui.msgBox.innerText = `💥 防禦失敗！\n結實地吃下攻擊，受到了 ${enemy.attack} 點傷害。`;
                    playerHpUpdate(enemy.attack);
                }
            }
        }

        function playerHpUpdate(dmg) {
            player.hp = Math.max(player.hp - dmg, 0); ui.playerHp.innerText = player.hp;
            if (player.hp === 0) setTimeout(() => { ui.msgBox.innerText = "布蕾蒂雅 倒下了... 戰鬥失敗。"; }, 1500);
            else setTimeout(() => { ui.msgBox.innerText = "輪到 布蕾蒂雅 行動了！"; ui.actionMenu.style.display = 'block'; }, 1500);
        }

        function dealDamageToEnemy(damage) {
            enemy.hp = Math.max(enemy.hp - damage, 0); ui.enemyHp.innerText = enemy.hp;
            if (enemy.hp === 0) setTimeout(() => { ui.msgBox.innerText = "赫爾墨斯 被打倒了！戰鬥勝利！"; }, 1500);
            else setTimeout(enemyTurn, 1500); 
        }

        function enemyTurn() {
            if (!enemy.shield && Math.random() < 0.3) {
                enemy.shield = true; ui.enemyStatus.innerText = "[護盾保護中]";
                ui.msgBox.innerText = `赫爾墨斯 舉起護盾！一般攻擊無效！`;
                setTimeout(() => { ui.msgBox.innerText = "輪到 布蕾蒂雅 行動了！"; ui.actionMenu.style.display = 'block'; }, 2000);
            } else {
                ui.msgBox.innerText = `赫爾墨斯 發動攻擊！\n(準備防禦...)`;
                setTimeout(() => {
                    currentAction = "defend"; configureQteZones('defend');
                    setupQteUI("防禦 / 閃避！", "#3498db", `赫爾墨斯 攻擊了！\n(藍區防禦，黃區閃避)`);
                    startQteAnimation(); 
                }, 1500);
            }
        }
    </script>
</body>
</html>

