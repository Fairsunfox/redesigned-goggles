                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let player = { name: "牢兔", hp: 20, maxHp: 20, sp: 10, maxSp: 10 };
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let enemy = { name: "雜魚", hp: 40, maxHp: 40, attack: 5, shield: false };
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            // ---------------------------------------------
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
